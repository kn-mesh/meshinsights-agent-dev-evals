# Published benchmark source (direct Microsoft Entra access by default)
APP_PROJECT_KEY=spirax-pulse
AZURE_POSTGRES_HOST=<server>.postgres.database.azure.com
AZURE_POSTGRES_DATABASE=label_benchmark
AZURE_POSTGRES_USER=<entra-user-or-group-name>

# Optional password-based programmatic fallback; never use for hosted operator access
DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/label_benchmark?sslmode=verify-full

# Immutable raw evidence source (same container used by Label Benchmark)
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=source-snapshots

# Dedicated write destination for explicitly published retained evals.
AZURE_EVAL_RESULTS_ACCOUNT_URL=https://<eval-results-account>.blob.core.windows.net
AZURE_EVAL_RESULTS_CONTAINER=eval-results

# AI runtime
AZURE_OPENAI_ENDPOINT=<azure-openai-endpoint>
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
OPENAI_API_VERSION=<azure-openai-api-version>
LOGFIRE_TOKEN=<optional-logfire-token>
