# Published benchmark source (Azure PostgreSQL; use a read-only runtime user)
APP_PROJECT_KEY=spirax-pulse
DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/label_benchmark?sslmode=verify-full

# Immutable raw evidence source (same container used by Label Benchmark)
AZURE_STORAGE_CONNECTION_STRING=<azure-storage-connection-string>
AZURE_STORAGE_CONTAINER=source-snapshots

# AI runtime
AZURE_OPENAI_ENDPOINT=<azure-openai-endpoint>
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
OPENAI_API_VERSION=<azure-openai-api-version>
LOGFIRE_TOKEN=<optional-logfire-token>
