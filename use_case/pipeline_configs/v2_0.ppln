name: pulse_alarm_failure_analysis_v2_0
version: 2.0.0

metadata_class: BenchmarkExamplePipelineMetadata

benchmark_contract:
  published_contract_schema_version: 3
  evidence_recipe_id: spirax-steam-trap-evidence@v2
  source_snapshot_contract: azure-blob-sha256-v1
  required_artifact_kinds: [telemetry, alarms]

objects:
  process: PulseFailureAnalysisProcessObject
  action: PulseFailureAnalysisActionObject

retrieve:
  hydrator: V1_3RetrieveToProcessHydrator
  retrievers:
    - retriever: SpiraxFrozenEvidenceRetriever

process:
  hydrator: V1_3ProcessToActionHydrator
  processors:
    - processor: V1_3TemperatureGraphsProcessor
      window_days_list: [7, 30, 365]
      segment_count: 4
      include_post_alarm_point: false
    - processor: V2_0AlarmClassificationAgent
      max_turns: 7
      timeout: 120
      tool_timeout: 30
      tool_calls_limit: 5
      finalize_on_tool_call_limit: true
      transport_retries: 3
      tool_retries: 1
      output_retries: 0

action:
  hydrator: V1_3FinalizeActionHydrator
  actions:
    - action: NoOpAction
