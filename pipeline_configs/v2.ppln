name: pulse_alarm_failure_analysis_v2
version: 2.0.0

metadata_class: BenchmarkExamplePipelineMetadata

objects:
  process: PulseFailureAnalysisProcessObject
  action: PulseFailureAnalysisActionObject

retrieve:
  hydrator: V1_3RetrieveToProcessHydrator
  retrievers:
    - retriever: AzureBlobBenchmarkEvidenceRetriever

process:
  hydrator: V2ProcessToActionHydrator
  processors:
    - processor: V1_3TemperatureGraphsProcessor
      window_days_list: [30, 365]
      segment_count: 4
    - processor: V2CaseBriefAIWorkflowProcessor
      window_days_list: [30, 365]
    - processor: V2CapabilityInvestigationAIAgentProcessor
      max_turns: 8
      tool_calls_limit: 4
      max_investigation_days: 45

action:
  hydrator: V1_3FinalizeActionHydrator
  actions:
    - action: NoOpAction
