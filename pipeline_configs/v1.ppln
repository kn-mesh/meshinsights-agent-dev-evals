name: baseline_template_pipeline
version: 1.0.0

# Placeholder example only.
# Replace every class name and file path with project-specific implementations
# before attempting to run this pipeline.

metadata_class: ExamplePipelineMetadata

objects:
  process: ExampleProcessObject
  action: ExampleActionObject

retrieve:
  hydrator: RetrieveToProcessHydrator
  retrievers:
    - retriever: ExampleRetriever
      file_path: ../../data/example/example.csv

process:
  hydrator: ProcessToActionHydrator
  processors:
    - processor: ExampleBaselineProcessor

action:
  hydrator: FinalizeActionHydrator
  actions:
    - action: NoOpAction
